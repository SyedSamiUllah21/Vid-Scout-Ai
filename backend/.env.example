# YouTube Researcher Configuration
# All APIs support automatic failover: if key 1 gets rate-limited,
# the system automatically switches to key 2.

# Get a YouTube API v3 key from Google Cloud Console (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_2=your_backup_youtube_api_key_here

# Get a Groq API key from Groq Console (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_backup_groq_api_key_here

# Optional: Get a Tavily API key from Tavily (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_KEY_2=your_backup_tavily_api_key_here

# Optional: Get an OpenRouter API key from OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=your_backup_openrouter_api_key_here
OPENROUTER_API_KEY_3=your_third_openrouter_api_key_here
